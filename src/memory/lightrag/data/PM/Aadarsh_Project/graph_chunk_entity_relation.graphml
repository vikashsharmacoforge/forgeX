<graph edgedefault="undirected"><node id="Rates Hub">
  <data key="d0">Rates Hub</data>
  <data key="d1">organization</data>
  <data key="d2">Rates Hub is a centralized rates management system designed to automate the process of publishing, approving, and distributing deposit and index rates for various financial products.&lt;SEP&gt;Rates Hub is a centralized system designed to modernize Synovus' rate management process, integrating with FIS Core Banking Platform.</data>
  <data key="d3">chunk-ee1213ffa17ffc41a07e252f9584c450&lt;SEP&gt;chunk-0fb258b4529ff68ce1928b2ebe9a514b</data>
  <data key="d4">./data/PM/Project\rateus hub requirements.txt</data>
  <data key="d5">1752657053</data>
</node>
<node id="Rates Committee Members">
  <data key="d0">Rates Committee Members</data>
  <data key="d1">person</data>
  <data key="d2">Rates Committee Members are users responsible for setting, approving, and publishing rates for various bank products, including promotional and relationship-based rates.</data>
  <data key="d3">chunk-ee1213ffa17ffc41a07e252f9584c450</data>
  <data key="d4">./data/PM/Project\rateus hub requirements.txt</data>
  <data key="d5">1752657053</data>
</node>
<node id="Branch Bankers">
  <data key="d0">Branch Bankers</data>
  <data key="d1">person</data>
  <data key="d2">Branch Bankers are users who access daily rate cards tailored to their branch and region, enabling them to offer accurate rates to customers.&lt;SEP&gt;Branch bankers are Synovus employees who interact with the Rates Hub system for rate-related tasks.</data>
  <data key="d3">chunk-ee1213ffa17ffc41a07e252f9584c450&lt;SEP&gt;chunk-0fb258b4529ff68ce1928b2ebe9a514b</data>
  <data key="d4">./data/PM/Project\rateus hub requirements.txt</data>
  <data key="d5">1752657053</data>
</node>
<node id="FIS Core Banking Platform">
  <data key="d0">FIS Core Banking Platform</data>
  <data key="d1">organization</data>
  <data key="d2">FIS Core Banking Platform is a financial system that requires integration with Rates Hub to access rates in real time.&lt;SEP&gt;FIS Core Banking Platform is a financial system used by Synovus for core banking operations and rate integration.</data>
  <data key="d3">chunk-ee1213ffa17ffc41a07e252f9584c450&lt;SEP&gt;chunk-0fb258b4529ff68ce1928b2ebe9a514b</data>

        "pythonCode": "# Loop over input items and add a new field called 'myNewField' to the JSON of each one\nimport json\n\nmessages = {\"messages\":[]}\nfor item in _input.all():\n  for message in item.json.body.data.messages:\n    role = message.role\n    content = message.content\n    msg = {\"role\":role,\"content\":content}\n    messages[\"messages\"].append(msg)\n\n  messages['state'] = item.json.body.data.state\n  messages['_uuid'] = item.json.body.data._uuid\n\nresponse = json.dumps(messages)\nresponse = response.replace('\"','\\\\\"')\nreturn {\"data\": str(response)}"
